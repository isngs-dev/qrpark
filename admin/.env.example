# Admin Portal: infrastructure and secrets only. Copy to .env.local (ignored by
# git) and fill in. Never commit a real value.

# The backend's address, read on the portal's server only (never NEXT_PUBLIC_).
# Development: defaults to http://localhost:3000. Production (next start): must be
# set and https://, or the portal refuses to start.
QRPARK_API_URL=http://localhost:3000

# T13: the same value as the backend's QRPARK_CLIENT_ADDRESS_SECRET, 32+ characters.
# The portal signs the browser's address (the rightmost X-Forwarded-For entry) with
# it, so the sign-in throttle counts each browser, not the portal. Never commit it.
QRPARK_CLIENT_ADDRESS_SECRET=

<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only. Replaces src/main's version to permit cleartext to
  10.0.2.2, the host machine as seen from the Android emulator, where the
  local backend listens on port 3000. Every other destination stays
  HTTPS-only. A release build never contains this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

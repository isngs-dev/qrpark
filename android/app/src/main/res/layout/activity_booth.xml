<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/booth_mode"
            android:textAppearance="@style/TextAppearance.QrPark.Headline" />

        <TextView
            android:id="@+id/whoWhere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.QrPark.Body" />

        <TextView
            android:id="@+id/site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.QrPark.Caption" />

        <!-- The scan field. A scanner (or typing) only fills it; Enter never submits.
             It never shows what was scanned: the text is masked (a ticket token). -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/scanLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/scan_ticket">

            <ng.gsds.qrpark.ScanTextField
                android:id="@+id/scanField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textPassword|textNoSuggestions"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/check" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cameraButton"
                style="@style/Widget.QrPark.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/scan_with_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/findButton"
                style="@style/Widget.QrPark.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/find_by_number" />
        </LinearLayout>

        <!-- The ticket and what can be done with it. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/ticketLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.QrPark.Title" />

                <TextView
                    android:id="@+id/ticketDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.QrPark.Caption" />

                <TextView
                    android:id="@+id/banner"
                    style="@style/Widget.QrPark.Banner"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.QrPark.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/takePaymentButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="72dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/methodRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cashButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="@string/cash" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cardButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="@string/card" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmCashButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="72dp"
                    android:visibility="gone" />

                <!-- A card payment waiting for Paystack. -->
                <LinearLayout
                    android:id="@+id/cardPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/waitingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.QrPark.Title"
                        android:textColor="@color/pending" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openCheckoutButton"
                        style="@style/Widget.QrPark.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/open_checkout" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelPaymentButton"
                        style="@style/Widget.QrPark.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/cancel_payment"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- UI-1: stacked, not side by side - these labels are too long to share a row. -->
                <LinearLayout
                    android:id="@+id/againRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tryCardAgainButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/try_card_again" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/takeCashButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/take_cash" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextButton"
                    style="@style/Widget.QrPark.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/next_ticket" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.QrPark.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/sign_out" />
    </LinearLayout>
</ScrollView>

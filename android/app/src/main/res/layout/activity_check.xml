<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/check_ticket"
        android:textAppearance="@style/TextAppearance.QrPark.Headline" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/scanLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/scan_or_type">

        <!-- A keyboard-wedge scanner types here. A scan only fills the field; Enter never submits.
             Masked (Sprint 4c): the scanned text is a ticket token and is never shown. -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/scanField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textPassword|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/checkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/check" />

    <TextView
        android:id="@+id/banner"
        style="@style/Widget.QrPark.Banner"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.QrPark.Body" />
</LinearLayout>

# Infrastructure and secrets only. Operational settings (categories, prices,
# validity hours, receipt details, gates, users) live in the database.
# Copy to .env (ignored by git) and fill in. Never commit a real value.
DATABASE_URL=postgresql://qrpark:qrpark@localhost:5433/qrpark
REDIS_URL=redis://localhost:6380
PORT=3000

# The one site this deployment serves. A code ending in -test can take test data.
SITE_CODE=garki-test
# Used by seed:site for a new site's display name only.
SITE_NAME=

# Token signing secret, at least 32 characters. The backend refuses to start
# without it. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First admin, created by seed:site if it does not exist. 12+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

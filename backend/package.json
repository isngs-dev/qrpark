{
  "name": "qrpark-backend",
  "version": "0.1.0",
  "private": true,
  "description": "QR Parking cloud backend.",
  "scripts": {
    "build": "prisma generate --allow-no-models && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "tsc -p tsconfig.json --outDir dist-test --incremental false && node --test --env-file-if-exists=.env \"dist-test/**/*.test.js\"",
    "prisma:generate": "prisma generate --allow-no-models"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "ioredis": "^6.0.0",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

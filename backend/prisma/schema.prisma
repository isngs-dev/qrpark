// QR Parking database schema. docs/schema.md is the full write-up; update it
// in the same commit as any migration.
//
// Rules that shaped this file:
//   * Every table carries site_id.
//   * All money is integer kobo. Never Float, never Decimal naira.
//   * The QR token is opaque random text, never an id, never sequential, and
//     is stored nowhere but ticket.token.
//   * Timestamps are set by the backend or the database, UTC, TIMESTAMPTZ.
//   * Columns are snake_case in the database, camelCase here (@map).
//
// The flow (0003): entry creates an UNPAID ticket; a payment booth takes cash
// or card; exit requires PAID. The ticket no longer depends on a payment; each
// payment points at its ticket.
//
// Prisma schema syntax cannot express the CHECK constraints, the partial
// unique indexes, lagos_day_end() or the triggers (ticket insert and guard,
// payment guard, audit_log append-only). They are raw SQL in the migrations
// (0001_init, 0003_booth_flow); see docs/schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ENTRY_OPERATOR
  EXIT_OPERATOR
  PAYMENT_OPERATOR

  @@map("user_role")
}

// The kind of location. The table keeps its name, gate; BOOTH is a payment booth.
enum GateDirection {
  ENTRY
  EXIT
  BOOTH

  @@map("gate_direction")
}

enum PaymentMethod {
  CASH
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  SUCCESS // card: Paystack confirmed; cash: recorded at the booth
  FAILED
  ABANDONED
  // Paystack confirmed a card payment for a ticket already PAID: the customer
  // paid twice. Terminal; not revenue; refunded in the Paystack dashboard.
  DUPLICATE

  @@map("payment_status")
}

enum TicketPaymentStatus {
  UNPAID
  PAID

  @@map("ticket_payment_status")
}

// EXPIRED is not stored: it is derived (not validated and now() >= valid_until).
enum TicketValidationStatus {
  NOT_VALIDATED
  VALIDATED

  @@map("ticket_validation_status")
}

enum ScanKind {
  CHECK // read-only, any operator job
  EXIT // the single-use validation

  @@map("scan_kind")
}

// ACTIVE only for CHECK, VALID only for EXIT (scan_event_result_by_kind_check).
enum ScanResult {
  VALID
  ACTIVE
  ALREADY_USED
  EXPIRED
  INVALID_QR
  NOT_FOUND
  PAYMENT_REQUIRED

  @@map("scan_result")
}

enum AuditAction {
  CATEGORY_CREATED
  CATEGORY_UPDATED // name or active flag
  CATEGORY_PRICE_CHANGED
  SETTINGS_CHANGED
  GATE_CREATED
  GATE_UPDATED
  USER_CREATED
  USER_UPDATED // name, role, gate or active flag
  USER_PASSWORD_RESET
  TICKET_REPRINTED
  USER_DELETED
  PAYMENT_CASH_CONFIRMED
  PAYMENT_CANCELLED // a PENDING card payment cancelled at the booth (POST /payments/:id/cancel)
  LOGIN_THROTTLED // a sign-in block started (Hardening H1); the only action without an actor

  @@map("audit_action")
}

// ---------------------------------------------------------------------------
// Site and its settings
// ---------------------------------------------------------------------------

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // matches SITE_CODE in the environment
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  setting    SiteSetting?
  users      AppUser[]
  gates      Gate[]
  categories VehicleCategory[]
  payments   Payment[]
  tickets    Ticket[]
  scanEvents ScanEvent[]
  auditLogs  AuditLog[]

  @@map("site")
}

// One row per site: site_id is the primary key.
model SiteSetting {
  siteId String @id @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  displayName String @map("display_name")

  // How long a PENDING card payment blocks its operator before it is
  // ABANDONED (unless Paystack confirms it first). 1-30 minutes.
  paymentWindowMinutes Int @default(5) @map("payment_window_minutes")

  // Printed on the ticket: the brand line, and the line beneath it.
  receiptOrgName     String? @map("receipt_org_name")
  receiptContactLine String? @map("receipt_contact_line")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_setting")
}

// ---------------------------------------------------------------------------
// Locations and users
// ---------------------------------------------------------------------------

// A location: an entry gate, a payment booth or an exit gate.
model Gate {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  code      String // stable key, e.g. "ENTRY_1", "BOOTH_1"; never changes
  name      String
  direction GateDirection // the kind; never changes: operators are assigned by it
  isActive  Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users            AppUser[]
  payments         Payment[]
  entryTickets     Ticket[]    @relation("TicketEntryGate")
  validatedTickets Ticket[]    @relation("TicketValidatedGate")
  scanEvents       ScanEvent[]

  @@unique([siteId, code])
  @@map("gate")
}

model AppUser {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // lower-case, 3-32 of a-z 0-9 . _ -; unique per site among LIVE accounts
  // only (app_user_live_username_key, a partial index in 0003), so a deleted
  // account's username can be reused.
  username     String
  name         String
  passwordHash String   @map("password_hash") // Argon2id. Never returned, never logged.
  role         UserRole

  // Null for ADMIN, required for an operator (app_user_gate_by_role_check).
  // The location's kind matches the job (enforced in code).
  gateId String? @map("gate_id") @db.Uuid
  gate   Gate?   @relation(fields: [gateId], references: [id], onDelete: Restrict)

  // Raised by logout, deactivation, deletion, a role or gate change, and a
  // password reset. A token carrying an older value is refused.
  tokenVersion Int @default(0) @map("token_version")

  isActive Boolean @default(true) @map("is_active")

  // Soft delete: hidden, cannot sign in; history kept. A deleted account is
  // inactive (app_user_deleted_is_inactive_check).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments   Payment[]
  issued     Ticket[]    @relation("TicketOperator")
  validated  Ticket[]    @relation("TicketValidatedBy")
  scanEvents ScanEvent[]
  auditLogs  AuditLog[]

  @@index([siteId, username])
  @@map("app_user")
}

// ---------------------------------------------------------------------------
// Vehicle categories: a flat price each
// ---------------------------------------------------------------------------

// Deactivate rather than delete: tickets keep their snapshot, and the
// category row must stay explicable.
model VehicleCategory {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  code      String // what the app sends, e.g. "CAR"; never changes
  name      String // what staff see
  priceKobo Int     @map("price_kobo") // integer kobo, > 0 (CHECK in 0001_init)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tickets Ticket[]

  @@unique([siteId, code])
  @@map("vehicle_category")
}

// ---------------------------------------------------------------------------
// Ticket and payment
// ---------------------------------------------------------------------------

// Created at entry, UNPAID. Becomes PAID only by pointing at a SUCCESS
// payment of its own (ticket_paid_payment_id_id_fkey + ticket_guard), and
// VALIDATED only when PAID. Token, number, fee, category, issue time,
// valid_until and idempotency key never change (ticket_guard).
model Ticket {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // From the entry app, one per entry attempt: a repeated tap returns this ticket.
  idempotencyKey String @unique @map("idempotency_key")

  // The QR. 32 random bytes as base64url (43 characters). Stored nowhere else.
  token        String @unique
  ticketNumber String @map("ticket_number") // XXXX-XXXX; not a credential

  // Entry: who, where, which device.
  operatorId String  @map("operator_id") @db.Uuid
  operator   AppUser @relation("TicketOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  gateId     String  @map("gate_id") @db.Uuid
  gate       Gate    @relation("TicketEntryGate", fields: [gateId], references: [id], onDelete: Restrict)
  deviceRef  String  @map("device_ref")

  // The category and its price at creation: the fee snapshot.
  categoryId   String          @map("category_id") @db.Uuid
  category     VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryCode String          @map("category_code")
  categoryName String          @map("category_name")
  feeKobo      Int             @map("fee_kobo")

  // Set by the database: issued_at defaults to now(); valid_until is always
  // lagos_day_end(issued_at), whatever an insert says (ticket_insert_guard).
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  validUntil DateTime @default(dbgenerated("lagos_day_end(now())")) @map("valid_until") @db.Timestamptz(6)

  paymentStatus TicketPaymentStatus @default(UNPAID) @map("payment_status")
  // The SUCCESS payment that made it PAID; a payment of THIS ticket
  // (composite key with id). Set once, with paid_at.
  paidPaymentId String?             @unique @map("paid_payment_id") @db.Uuid
  paidPayment   Payment?            @relation("TicketPaidPayment", fields: [paidPaymentId, id], references: [id, ticketId], onDelete: Restrict, onUpdate: Restrict)
  paidAt        DateTime?           @map("paid_at") @db.Timestamptz(6)

  validationStatus TicketValidationStatus @default(NOT_VALIDATED) @map("validation_status")
  validatedAt      DateTime?              @map("validated_at") @db.Timestamptz(6)
  validatedGateId  String?                @map("validated_gate_id") @db.Uuid
  validatedGate    Gate?                  @relation("TicketValidatedGate", fields: [validatedGateId], references: [id], onDelete: Restrict)
  validatedById    String?                @map("validated_by_id") @db.Uuid
  validatedBy      AppUser?               @relation("TicketValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments   Payment[]   @relation("TicketPayments")
  scanEvents ScanEvent[]

  // Target of the payment's composite key: a payment's amount must equal
  // its ticket's fee snapshot.
  @@unique([id, feeKobo])
  @@unique([siteId, ticketNumber])
  @@index([siteId, issuedAt])
  @@index([siteId, paymentStatus, validationStatus, validUntil])
  @@map("ticket")
}

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // The ticket paid for, and its fee: (ticket_id, amount_kobo) must match
  // ticket (id, fee_kobo).
  ticketId   String @map("ticket_id") @db.Uuid
  amountKobo Int    @map("amount_kobo")
  ticket     Ticket @relation("TicketPayments", fields: [ticketId, amountKobo], references: [id, feeKobo], onDelete: Restrict, onUpdate: Restrict)

  method PaymentMethod

  // Our own reference (cash too); for a card, also Paystack's. The webhook
  // idempotency key.
  reference String @unique

  // From the booth app, one per payment attempt.
  idempotencyKey String @unique @map("idempotency_key")

  // The booth: who, where, which device.
  operatorId String  @map("operator_id") @db.Uuid
  operator   AppUser @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  gateId     String  @map("gate_id") @db.Uuid
  gate       Gate    @relation(fields: [gateId], references: [id], onDelete: Restrict)
  deviceRef  String  @map("device_ref")

  status PaymentStatus @default(PENDING)

  // Card only: Paystack's checkout.
  authorizationUrl String? @map("authorization_url")
  accessCode       String? @map("access_code")

  // Card only: the last verified Paystack payload (authorization_code removed).
  paystackEvent Json? @map("paystack_event")

  // Backend time when SUCCESS was recorded. Set if and only if SUCCESS.
  paidAt DateTime? @map("paid_at") @db.Timestamptz(6)

  // Card only: Paystack's own paid time. Reconciliation only.
  paystackPaidAt DateTime? @map("paystack_paid_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paidTickets Ticket[] @relation("TicketPaidPayment")

  // Target of the ticket's composite key: the paying payment belongs to it.
  @@unique([id, ticketId])
  @@index([siteId, status])
  @@index([ticketId])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Scans and audit
// ---------------------------------------------------------------------------

// Every check and every exit scan. Never stores the scanned text: a code that
// matched no ticket leaves no trace of itself here.
model ScanEvent {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  ticketId String? @map("ticket_id") @db.Uuid
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  kind   ScanKind
  result ScanResult

  gateId     String  @map("gate_id") @db.Uuid
  gate       Gate    @relation(fields: [gateId], references: [id], onDelete: Restrict)
  operatorId String  @map("operator_id") @db.Uuid
  operator   AppUser @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  // The app's installation id. Recorded only, never trusted.
  deviceRef String @map("device_ref")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([siteId, occurredAt])
  @@index([ticketId])
  @@map("scan_event")
}

// Who did what, when, to which record. Append-only: a trigger in 0001_init
// raises on UPDATE and DELETE.
model AuditLog {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // Required for every action but LOGIN_THROTTLED (CHECK audit_log_actor_required_check, 0005).
  actorId String?  @map("actor_id") @db.Uuid
  actor   AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  action     AuditAction
  targetType String      @map("target_type")
  targetId   String      @map("target_id")

  // Before and after values. Never a password, a hash or a token.
  detail Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([siteId, occurredAt])
  @@index([siteId, targetType, targetId])
  @@map("audit_log")
}

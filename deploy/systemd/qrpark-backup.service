# Daily database backup (Sprint 6a). Installed by docs/07-deploy-digitalocean.md:
#   sudo cp deploy/systemd/qrpark-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now qrpark-backup.timer
[Unit]
Description=QR Parking database backup (pg_dump, 14 days kept)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0077
ExecStart=/opt/qrpark/deploy/backup.sh
